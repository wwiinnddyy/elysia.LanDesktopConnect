<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!--
      LanMountainDesktop.AirAppSdk 发布在 GitHub Packages；GitHub Packages 即使托管公开包，
      还原时也必须给凭据。源地址与"凭据放在哪个槽"这两件事只在本文件里说一次，
      凭据本身用环境变量占位符引用（NuGet 会替换 %VAR%）：
        - CI：把这两个变量指向工作流自带的 GITHUB_TOKEN 就够了（可读公开包；前提是 job 声明了
          permissions 里的 packages: read），既不用配 PAT 也不用配仓库 secret。
        - 本地：设 LANMOUNTAIN_PACKAGES_USER / LANMOUNTAIN_PACKAGES_TOKEN（PAT 需 read:packages）。
      不要再跑 dotnet nuget add source（同名源已在本文件里，add 直接失败），也不要用 update source
      （Linux runner 上它报 "Password encryption is not supported on .NET Core for this platform."）。
      旧的本地 packages 饲料（Initialize-LocalPackageFeed.ps1）已随 AirApp SDK 1.0.1 迁移退役。
    -->
    <add key="lanmountain" value="https://nuget.pkg.github.com/wwiinnddyy/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <lanmountain>
      <add key="Username" value="%LANMOUNTAIN_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%LANMOUNTAIN_PACKAGES_TOKEN%" />
    </lanmountain>
  </packageSourceCredentials>
</configuration>
